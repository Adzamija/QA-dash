# QA-Dash Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git - it contains secrets!

# ===================================================================
# LLM CONFIGURATION (Anthropic Claude)
# ===================================================================
# Required for all AI agents. Generate key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===================================================================
# JIRA INTEGRATION (REST API or MCP Server)
# ===================================================================
# Your Jira instance URL (e.g., https://your-company.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net
# Your Jira user email (used for Basic Auth header)
JIRA_USER_EMAIL=your_email@company.com
# Jira API Token: Generate at https://id.atlassian.com/manage-profile/security/api-tokens
# NOTE: For local dev, you can also input this via UI (Settings → Tokens)
JIRA_API_TOKEN=your_jira_api_token

# ===================================================================
# GITHUB INTEGRATION (CLI 'gh' or REST API)
# ===================================================================
# GitHub Personal Access Token (Classic) with 'repo' scope
# Generate at: https://github.com/settings/tokens
# NOTE: Ensure 'gh' CLI is installed and authenticated: gh auth status
GITHUB_TOKEN=ghp_...

# ===================================================================
# AZURE DEVOPS INTEGRATION (CLI 'az' or REST API)
# ===================================================================
# Azure DevOps Organization URL (e.g., https://dev.azure.com/your-org)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
# Azure Personal Access Token (PAT) with 'Code (Read & Write)' scope
# Generate at: https://dev.azure.com/your-org/_usersSettings/tokens
# NOTE: Ensure 'az' CLI is installed and logged in: az login
AZURE_DEVOPS_PAT=your_azure_pat

# ===================================================================
# TESTRAIL INTEGRATION (REST API)
# ===================================================================
# TestRail Instance URL (e.g., https://your-company.testrail.io)
TESTRAIL_BASE_URL=https://your-company.testrail.io
# TestRail User Email
TESTRAIL_API_EMAIL=your_email@company.com
# TestRail API Key: Find in Profile Settings → API Keys
TESTRAIL_API_KEY=your_testrail_api_key

# ===================================================================
# MCP SERVER CONFIGURATION (Optional - for local tool integrations)
# ===================================================================
# Enable MCP servers for direct tool access (jira, github, azure, etc.)
MCP_JIRA_ENABLED=true
MCP_GITHUB_ENABLED=true
MCP_AZURE_ENABLED=true

# ===================================================================
# CLI TOOLS VALIDATION (Fail-Fast Pre-Flight Checks)
# ===================================================================
# The app will check if these tools are installed before running agents:
# - 'gh' (GitHub CLI): Required for Functional Reviewer with GitHub PRs
# - 'az' (Azure CLI): Required for Functional Reviewer with Azure PRs
# - 'jira' (Jira CLI): Optional if using REST API instead
# Run these commands to verify:
#   gh auth status
#   az account show
#   which jira

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================
NODE_ENV=development
VITE_APP_TITLE=QA-Dash Local
VITE_DEBUG_MODE=false

# ===================================================================
# SECURITY NOTES
# ===================================================================
# 1. Never commit .env.local to version control
# 2. Use UI (Settings → Tokens) for runtime token management when possible
# 3. Rotate tokens regularly and revoke unused ones
# 4. If a tool/MCP is missing, the app will fail-fast with explicit errors
